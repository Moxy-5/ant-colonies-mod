# The Cape buffalo in the game, frame by frame (2026-11-25, CLAUDE.md's hard rule: every clip filmed in the real game,
# frozen and stepped, from three sides; docs/plans/buffalo.md step 1): each clip on a still bull named film:<clip> (it
# plays only that clip, looped) on flat grass, side on, three quarters from the front and above, and from the front, each
# burst covering the whole clip; then a walking bull up a 1-block step and down it (no block moves in step 1: Minecraft's
# own step with the trunk tilting to the ground under its front and hind feet, client/BuffaloModel), stepped 3 ticks a
# picture from three sides. The bull faces east (+x); the model is drawn 10 px toward its head.
# Each bull is killed and its death (33 ticks) waited out, then its carcass cleared (2026-11-25, BUGS 383), so no dying
# bull or carcass stands in the next bull's pictures.
#   ./gradlew runFilm -PfilmScene=tools/film/buffalo_frames.film   pictures in run-film/screenshots/buffalo_frames/
cmd time set noon
cmd weather clear
cmd kill @e[type=!player]
cmd fill 36 -61 -12 60 -50 12 minecraft:air
cmd fill 36 -62 -12 60 -62 12 minecraft:grass_block
lens 50
wait 40
cmd summon antcolonies:buffalo 46.5 -61 0.5 {NoAI:1b,OwnSize:1.0f,Rotation:[-90f,0f],CustomName:'"film:walk"'}
camera 46.50 -59.00 -9.00 0 4
wait 10
cmd tick freeze
burst walk_side 12 2
cmd tick unfreeze
cmd kill @e[type=antcolonies:buffalo]
wait 36
cmd kill @e[type=antcolonies:remains]
wait 3
cmd summon antcolonies:buffalo 46.5 -61 0.5 {NoAI:1b,OwnSize:1.0f,Rotation:[-90f,0f],CustomName:'"film:walk"'}
camera 53.50 -56.50 -6.00 45 16
wait 10
cmd tick freeze
burst walk_threequarter 12 2
cmd tick unfreeze
cmd kill @e[type=antcolonies:buffalo]
wait 36
cmd kill @e[type=antcolonies:remains]
wait 3
cmd summon antcolonies:buffalo 46.5 -61 0.5 {NoAI:1b,OwnSize:1.0f,Rotation:[-90f,0f],CustomName:'"film:walk"'}
