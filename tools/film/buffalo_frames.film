# --- up a 1-block step (its west face at x 10) at the travel pace, and down off it going west: side on, front, behind
cmd fill -4 -61 -8 24 -55 8 minecraft:air
cmd fill -4 -62 -8 24 -62 8 minecraft:dirt
cmd fill 10 -61 -8 24 -61 8 minecraft:grass_block
cmd fill -4 -62 -8 9 -62 8 minecraft:grass_block
lens 40
wait 20
walker antcolonies:buffalo 5.5 -61 0.5 -90 OwnSize:1.0f,Led:1b
camera 10.5 -59.6 -11.5 0 4
cmd tick unfreeze
go 17 -60 0 1.0
wait 20
cmd tick freeze
burst up_side 40 3
cmd tick unfreeze
cmd kill @e[type=antcolonies:buffalo]
wait 36
cmd kill @e[type=antcolonies:remains]
wait 10
walker antcolonies:buffalo 5.5 -61 0.5 -90 OwnSize:1.0f,Led:1b
camera 18.5 -57.6 -6.5 52 14
cmd tick unfreeze
go 17 -60 0 1.0
wait 20
cmd tick freeze
burst up_front 40 3
cmd tick unfreeze
