# Second take: trailing a player who steps back to 13 blocks, then the bite from just inside its reach.
cmd time set noon
cmd weather clear
cmd kill @e[type=!player]
cmd fill 6 -63 4 14 -61 30 minecraft:water
lens 50
wait 30
cmd summon antcolonies:monitor 20.5 -60 17.0 {OwnSize:1.0f,HungryIn:99999,SunIn:99999,Rotation:[90f,0f]}
