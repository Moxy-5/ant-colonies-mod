# The measuring course (a level walk (the gait, the feet, the back at rest)) for the monitor: written by tools/body_course.py films, do not edit.
lens 50
walker antcolonies:monitor -6.5 -60 0.5 -90 OwnSize:1.0f,HungryIn:99999,SunIn:99999
follow 0 3.5 -6 0 25
cmd tick unfreeze
record on 3
go 3 -60 0 0.8
wait 60
shot p00
wait 60
shot p01
wait 60
shot p02
wait 60
shot p03
wait 60
shot p04
wait 60
shot p05
wait 60
shot p06
wait 36
shot p07
record off
