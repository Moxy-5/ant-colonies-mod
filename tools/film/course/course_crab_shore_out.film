# The measuring course (walking from a river bed one block under water up a one-block bank onto the shore) for the crab: written by tools/body_course.py films, do not edit.
lens 50
cmd fill -12 -61 -7 0 -61 7 minecraft:water
walker antcolonies:crab -4.5 -61 0.5 -90
follow 0 3.5 -6 0 25
cmd tick unfreeze
record on 3
go 5 -60 0 1.0
wait 60
shot p00
wait 60
shot p01
wait 56
shot p02
record off
