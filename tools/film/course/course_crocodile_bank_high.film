# The measuring course (into water from a bank two blocks above it) for the crocodile: written by tools/body_course.py films, do not edit.
lens 50
cmd fill -12 -60 -7 0 -59 7 minecraft:grass_block
cmd fill 1 -63 -7 12 -61 7 minecraft:water
walker antcolonies:crocodile -4.5 -58 0.5 -90 OwnSize:1.0f
follow 0 3.5 -6 0 25
cmd tick unfreeze
record on 3
go 8 -61 0 1.0
wait 60
shot p00
wait 60
shot p01
wait 60
shot p02
wait 60
shot p03
wait 60
shot p04
wait 33
shot p05
record off
