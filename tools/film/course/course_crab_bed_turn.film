# The measuring course (a walk on the river bed with two right-angle turns) for the crab: written by tools/body_course.py films, do not edit.
lens 50
cmd fill -12 -63 -7 12 -60 7 minecraft:water
walker antcolonies:crab -4.5 -63 -3.5 -90
follow 0 3.5 -6 0 25
cmd tick unfreeze
record on 3
go 2 -63 -4 1.0
wait 60
shot p00
wait 60
shot p01
wait 14
shot p02
go 2 -63 3 1.0
wait 60
shot p03
wait 60
shot p04
wait 14
shot p05
go -4 -63 3 1.0
wait 60
shot p06
wait 60
shot p07
wait 1
shot p08
record off
