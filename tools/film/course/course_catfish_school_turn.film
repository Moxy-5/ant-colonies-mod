# The measuring course (a school turning: four more of its kind (their own minds) round the one sent through two turns) for the catfish: written by tools/body_course.py films, do not edit.
lens 50
cmd fill -12 -63 -7 12 -61 7 minecraft:water
walker antcolonies:catfish -6.5 -62 -4.5 -90
cmd summon antcolonies:catfish -7.5 -62 -5.5 {PersistenceRequired:1b}
cmd summon antcolonies:catfish -7.5 -62 -3.5 {PersistenceRequired:1b}
cmd summon antcolonies:catfish -5.5 -62 -5.5 {PersistenceRequired:1b}
cmd summon antcolonies:catfish -5.5 -62 -3.5 {PersistenceRequired:1b}
follow 0 3.5 -6 0 25
cmd tick unfreeze
record on 3
go 2 -62 -5 1.0
wait 60
shot p00
wait 60
shot p01
go 2 -62 4 1.0
wait 60
shot p02
wait 60
shot p03
go -6 -62 4 1.0
wait 60
shot p04
wait 51
shot p05
record off
