# Guard film: up the wall of a trench and upside down along a roof over it (a ceiling), then back down. The trench
# runs right across the floor, so the camera beside the ant stands in it and sees the ant's side.
cmd time set noon
cmd weather clear
cmd fill 3 -63 -12 7 -61 12 air
cmd fill 2 -60 -2 2 -59 2 stone
cmd fill 8 -60 -2 8 -59 2 stone
cmd fill 2 -58 -2 8 -58 2 stone
lens 30
walker worker_ant 6.5 -63 0.5 -90
log ceiling
cmd tick freeze
fov 10
follow 0 0.15 -6 0 0
go 5 -59 0
burst onto_ceiling 150 1
go 5 -63 0
burst down_again 80 1
log off
follow off
quit
