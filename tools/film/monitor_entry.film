# The Nile monitor going into the water, one picture a tick (2026-11-18, the user's report: the hind legs swung up as it
# went in, and the body opened a wedge across the shoulders at the bank's edge). A live one scared on a level bank runs
# for the water and dives; side view, close.
#   ./gradlew runFilm -PfilmScene=tools/film/monitor_entry.film      pictures in run-film/screenshots/monitor_entry/
cmd time set noon
cmd weather clear
cmd kill @e[type=!player]
cmd fill 26 -63 12 40 -61 22 minecraft:water
lens 40
wait 40
camera 25.0 -60.3 12.0 0 10
cmd summon antcolonies:monitor 20.0 -60.0 17.0 {OwnSize:1.0f,HungryIn:99999,SunIn:99999,Rotation:[-90f,0f]}
wait 30
cmd execute positioned 20 -60 17 run damage @e[type=antcolonies:monitor,limit=1,sort=nearest] 0.5 minecraft:cactus
wait 12
shot e_00
wait 1
shot e_01
wait 1
