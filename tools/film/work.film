# The work scene: the cleaning, nestmate-grooming and carrying clips filmed on their own (one ant on the floor at a time).
# Run: ./gradlew runFilm -PfilmScene=tools/film/work.film   Pictures: run-film/screenshots/work/
cmd time set noon
cmd weather clear
lens 30
ant matabele_minor groom_antenna_l
views groom_antenna_l
ant matabele_minor groom_nestmate
views groom_nestmate 8
ant matabele_minor carry
views carry
quit
