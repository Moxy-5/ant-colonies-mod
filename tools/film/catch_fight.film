# The catch that ends bitten in two (2026-11-15, the user's ask): the tilapia in the catfish's mouth fights harder and
# harder, works itself a little way out; the catfish lunges, takes a new hold and bites it through at its middle; the
# front half falls away as remains. From the side, then from above, then a small fish. A shot takes time itself, so
# the pictures' names are only roughly the tick of the hold.
#   ./gradlew runFilm -PfilmScene=catch_fight      pictures in run-film/screenshots/catch_fight/
cmd time set noon
cmd weather clear
cmd fill -5 -60 -5 5 -53 4 minecraft:barrier hollow
cmd fill -4 -60 -4 4 -54 3 minecraft:water
lens 30
wait 40
camera 0.7 -59.0 -1.9 0 0
cmd summon antcolonies:catfish 0.0 -57.5 0.5 {NoAI:1b,NoGravity:1b,Rotation:[-90f,0f],HeldLook:1,HeldSize:1.0f,HeldOnRight:1b,HeldTicks:46,HeldCut:1b}
wait 2
shot side_02
wait 3
shot side_06
wait 3
shot side_10
wait 3
shot side_14
wait 1
shot side_16
wait 1
shot side_18
wait 1
shot side_20
wait 1
shot side_22
wait 1
shot side_24
wait 1
shot side_26
shot side_27
shot side_28
shot side_29
shot side_30
shot side_31
shot side_32
shot side_33
wait 1
shot side_35
wait 2
shot side_38
wait 3
shot side_42
cmd tp @e[type=antcolonies:catfish] 0 -120 0
cmd kill @e[type=antcolonies:remains]
wait 10
camera 1.0 -57.0 0.5 90 90
cmd summon antcolonies:catfish 0.0 -57.5 0.5 {NoAI:1b,NoGravity:1b,Rotation:[-90f,0f],HeldLook:2,HeldSize:1.0f,HeldOnRight:1b,HeldTicks:46,HeldCut:1b}
wait 10
shot above_10
wait 5
shot above_16
wait 3
shot above_20
wait 3
shot above_24
wait 2
shot above_27
wait 1
shot above_29
shot above_30
shot above_31
wait 2
shot above_34
cmd tp @e[type=antcolonies:catfish] 0 -120 0
cmd kill @e[type=antcolonies:remains]
wait 10
camera 0.7 -59.0 -1.9 0 0
cmd summon antcolonies:catfish 0.0 -57.5 0.5 {NoAI:1b,NoGravity:1b,Rotation:[-90f,0f],HeldLook:0,HeldSize:0.5f,HeldTicks:46,HeldCut:1b}
wait 10
shot small_10
wait 9
shot small_20
wait 5
shot small_26
wait 2
shot small_29
shot small_30
shot small_31
wait 2
shot small_34
cmd tp @e[type=antcolonies:catfish] 0 -120 0
cmd kill @e[type=antcolonies:remains]
wait 10
quit
