# The crocodile's hunt and death roll (2026-11-15, the user's ask): a hungry crocodile in the pool, a cow at the edge.
#   ./gradlew runFilm -PfilmScene=crocodile_hunt      pictures in run-film/screenshots/crocodile_hunt/
cmd time set noon
cmd weather clear
cmd fill 26 -63 8 44 -61 26 minecraft:water
lens 50
wait 40
cmd summon antcolonies:crocodile 35.5 -61 17.0 {HungerIn:0,SunIn:100000,Rotation:[90f,0f]}
cmd summon minecraft:cow 24.6 -60 17.0 {NoAI:1b,Rotation:[90f,0f]}
