# The river snail in the game (2026-11-16): the Garden spiral standing on the grass (front, side, above), crawling,
# a hungry one grazing algae on the bed of a shallow pool, then hiding in its shell from a crab and peeking out.
#   ./gradlew runFilm -PfilmScene=snail      pictures in run-film/screenshots/snail/
cmd time set noon
cmd weather clear
cmd kill @e[type=!player]
lens 40
wait 30
# (the camera's height is its feet: its eye is 1.62 higher)
cmd summon antcolonies:snail 0.5 -60.0 3.5 {NoAI:1b,Rotation:[180f,0f]}
camera 0.5 -61.45 2.5 0 14
wait 30
shot stand_front
camera 1.5 -61.5 3.5 90 10
wait 5
shot stand_side
camera 0.5 -60.6 3.5 0 89
wait 5
shot stand_top
camera 1.3 -61.4 2.7 45 16
wait 5
shot stand_corner
cmd kill @e[type=antcolonies:snail]
wait 5
# crawling: a live one on the grass
cmd summon antcolonies:snail 8.5 -60.0 3.5 {HungryIn:100000,Rotation:[180f,0f]}
camera 8.5 -60.6 2.0 0 45
wait 20
shot crawl_0
wait 15
shot crawl_1
wait 15
shot crawl_2
wait 15
shot crawl_3
wait 15
shot crawl_4
wait 15
shot crawl_5
wait 15
cmd kill @e[type=antcolonies:snail]
wait 5
# grazing: a shallow pool, lush algae, a hungry snail beside it
cmd fill 16 -62 -2 22 -61 4 minecraft:water
cmd setblock 19 -62 1 antcolonies:algae[growth=3,strands=7]
cmd summon antcolonies:snail 18.3 -62.0 1.5 {HungryIn:0,Rotation:[-90f,0f]}
camera 19.9 -62.7 0.4 40 28
wait 20
wait 160
shot graze_00
wait 12
shot graze_01
wait 12
shot graze_02
wait 12
shot graze_03
wait 12
shot graze_04
wait 12
shot graze_05
wait 12
shot graze_06
wait 12
shot graze_07
wait 12
shot graze_08
wait 12
shot graze_09
wait 12
shot graze_10
wait 12
shot graze_11
wait 12
shot graze_12
wait 12
shot graze_13
wait 12
shot graze_14
wait 12
shot graze_15
wait 12
# hiding: a crab beside it, then the crab gone
cmd summon antcolonies:crab 20.6 -62.0 1.5 {NoAI:1b,Rotation:[90f,0f]}
wait 6
shot hide_0
wait 6
shot hide_1
wait 20
shot hide_2
cmd kill @e[type=antcolonies:crab]
wait 15
shot peek_00
wait 15
shot peek_01
wait 15
shot peek_02
wait 15
shot peek_03
wait 15
shot peek_04
wait 15
shot peek_05
wait 15
shot peek_06
wait 15
shot peek_07
wait 15
shot peek_08
wait 15
shot peek_09
wait 15
shot peek_10
wait 15
shot peek_11
wait 15
shot peek_12
wait 15
shot peek_13
