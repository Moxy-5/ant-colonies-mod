# The crocodile's blink (2026-11-17, the user's ask): a still crocodile on the grass, the camera close on its left eye.
#   ./gradlew runFilm -PfilmScene=tools/film/croc_blink.film      pictures in run-film/screenshots/croc_blink/
cmd time set noon
cmd weather clear
cmd kill @e[type=!player]
lens 30
wait 30
cmd summon antcolonies:crocodile 20.5 -60 17.0 {NoAI:1b,Rotation:[90f,0f]}
camera 17.6 -60.3 19.2 -150 12
wait 30
shot eye_00
wait 3
