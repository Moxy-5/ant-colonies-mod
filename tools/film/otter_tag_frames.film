# The otter's chase-and-tag clips in the game (2026-11-23, docs/plans/otter-play-and-fish.md 6d game 2; the hard rule:
# frozen and stepped from three sides). pounce_tag: a chaser named film:pounce_tag stands behind a runner (film:idle),
# both facing west, as far behind as the game will put it (its paws 13 px ahead of its middle on the runner's rump 8 px
# behind the runner's middle: 21 px, 1.31 blocks), so the paws come down on the runner's back. porpoise: an otter held
# at the swim's height in a pool (its middle 11.3 px under the surface, no gravity), the leap drawn by the clip.
# One clip stepped a tick a picture.
#   ./gradlew runFilm -PfilmScene=tools/film/otter_tag_frames.film   pictures in run-film/screenshots/otter_tag_frames/
cmd time set noon
cmd weather clear
cmd kill @e[type=!player]
cmd fill 0 -61 0 40 -50 34 minecraft:air
cmd fill 0 -64 0 40 -62 34 minecraft:dirt
cmd fill 0 -61 0 40 -61 34 minecraft:grass_block
cmd fill 2 -63 22 38 -61 32 minecraft:water
lens 40
wait 40
# --- the pounce: side on, three quarters from in front, from behind the chaser
cmd tick unfreeze
cmd summon antcolonies:otter 20.5 -60 12.0 {NoAI:1b,Rotation:[90f,0f],OwnSize:1.0f,CustomName:'"film:idle"'}
cmd summon antcolonies:otter 21.8125 -60 12.0 {NoAI:1b,Rotation:[90f,0f],OwnSize:1.0f,CustomName:'"film:pounce_tag"'}
camera 20.6 -60.6 8.4 0 6
wait 30
cmd tick freeze
burst pounce_side 17 1
cmd tick unfreeze
cmd kill @e[type=antcolonies:otter]
wait 20
cmd summon antcolonies:otter 20.5 -60 12.0 {NoAI:1b,Rotation:[90f,0f],OwnSize:1.0f,CustomName:'"film:idle"'}
cmd summon antcolonies:otter 21.8125 -60 12.0 {NoAI:1b,Rotation:[90f,0f],OwnSize:1.0f,CustomName:'"film:pounce_tag"'}
camera 17.6 -59.8 9.6 -55 14
wait 30
cmd tick freeze
burst pounce_three 17 1
cmd tick unfreeze
cmd kill @e[type=antcolonies:otter]
wait 20
cmd summon antcolonies:otter 20.5 -60 12.0 {NoAI:1b,Rotation:[90f,0f],OwnSize:1.0f,CustomName:'"film:idle"'}
cmd summon antcolonies:otter 21.8125 -60 12.0 {NoAI:1b,Rotation:[90f,0f],OwnSize:1.0f,CustomName:'"film:pounce_tag"'}
camera 25.2 -59.4 10.2 67 16
wait 30
cmd tick freeze
burst pounce_behind 17 1
cmd tick unfreeze
cmd kill @e[type=antcolonies:otter]
wait 20
# --- the porpoise: side on at the water, three quarters, from in front
cmd summon antcolonies:otter 20.5 -60.82 27.0 {NoAI:1b,NoGravity:1b,Rotation:[90f,0f],OwnSize:1.0f,CustomName:'"film:porpoise"'}
camera 20.2 -60.0 22.6 0 4
wait 30
cmd tick freeze
burst porpoise_side 20 1
cmd tick unfreeze
cmd kill @e[type=antcolonies:otter]
wait 20
cmd summon antcolonies:otter 20.5 -60.82 27.0 {NoAI:1b,NoGravity:1b,Rotation:[90f,0f],OwnSize:1.0f,CustomName:'"film:porpoise"'}
camera 17.2 -59.3 23.8 -45 14
wait 30
cmd tick freeze
burst porpoise_three 20 1
cmd tick unfreeze
cmd kill @e[type=antcolonies:otter]
wait 20
cmd summon antcolonies:otter 20.5 -60.82 27.0 {NoAI:1b,NoGravity:1b,Rotation:[90f,0f],OwnSize:1.0f,CustomName:'"film:porpoise"'}
camera 16.0 -59.9 27.0 -90 6
wait 30
cmd tick freeze
burst porpoise_front 20 1
cmd tick unfreeze
cmd kill @e[type=antcolonies:otter]
