# The six-banded distichodus in the game, frame by frame (the river food web's step 5, 2026-11-23; CLAUDE.md's hard
# rule): every clip on a still fish named film:<clip> (it plays only that clip), side on, three quarters and (the
# swimming clips) from the front, the game frozen and stepped a tick or two a picture; then a free group in the pool.
#   ./gradlew runFilm -PfilmScene=tools/film/distichodus_frames.film   pictures in run-film/screenshots/distichodus_frames/
cmd time set noon
cmd weather clear
cmd kill @e[type=!player]
# the pool: x 26..44, 3 deep, flush with the grass
cmd fill 26 -63 -8 44 -61 8 minecraft:water
lens 30
wait 40
cmd summon antcolonies:distichodus 33.5 -62.15 0.5 {NoAI:1b,Rotation:[-90f,0f],CustomName:'"film:idle"'}
camera 33.50 -63.67 -1.80 0 0
wait 10
cmd tick freeze
burst idle_side 20 2
cmd tick unfreeze
cmd tp @e[type=antcolonies:distichodus] 33 -140 0
wait 3
cmd summon antcolonies:distichodus 33.5 -62.15 0.5 {NoAI:1b,Rotation:[-90f,0f],CustomName:'"film:idle"'}
camera 31.87 -63.27 -1.13 -45 10
wait 10
cmd tick freeze
burst idle_threequarter 20 2
cmd tick unfreeze
cmd tp @e[type=antcolonies:distichodus] 33 -140 0
wait 3
cmd summon antcolonies:distichodus 33.5 -62.15 0.5 {NoAI:1b,Rotation:[-90f,0f],CustomName:'"film:swim"'}
camera 33.50 -63.67 -1.80 0 0
wait 10
cmd tick freeze
burst swim_side 12 1
cmd tick unfreeze
cmd tp @e[type=antcolonies:distichodus] 33 -140 0
wait 3
cmd summon antcolonies:distichodus 33.5 -62.15 0.5 {NoAI:1b,Rotation:[-90f,0f],CustomName:'"film:swim"'}
camera 31.87 -63.27 -1.13 -45 10
wait 10
cmd tick freeze
burst swim_threequarter 12 1
cmd tick unfreeze
cmd tp @e[type=antcolonies:distichodus] 33 -140 0
wait 3
cmd summon antcolonies:distichodus 33.5 -62.15 0.5 {NoAI:1b,Rotation:[-90f,0f],CustomName:'"film:swim"'}
camera 35.80 -63.67 0.50 90 0
wait 10
cmd tick freeze
burst swim_front 12 1
cmd tick unfreeze
cmd tp @e[type=antcolonies:distichodus] 33 -140 0
wait 3
cmd summon antcolonies:distichodus 33.5 -62.15 0.5 {NoAI:1b,Rotation:[-90f,0f],CustomName:'"film:graze"'}
camera 33.50 -63.67 -1.80 0 0
wait 10
cmd tick freeze
burst graze_side 24 2
cmd tick unfreeze
cmd tp @e[type=antcolonies:distichodus] 33 -140 0
wait 3
cmd summon antcolonies:distichodus 33.5 -62.15 0.5 {NoAI:1b,Rotation:[-90f,0f],CustomName:'"film:graze"'}
camera 31.87 -63.27 -1.13 -45 10
wait 10
cmd tick freeze
burst graze_threequarter 24 2
cmd tick unfreeze
cmd tp @e[type=antcolonies:distichodus] 33 -140 0
wait 3
cmd summon antcolonies:distichodus 33.5 -62.15 0.5 {NoAI:1b,Rotation:[-90f,0f],CustomName:'"film:nibble"'}
camera 33.50 -63.67 -1.80 0 0
wait 10
cmd tick freeze
burst nibble_side 18 2
cmd tick unfreeze
cmd tp @e[type=antcolonies:distichodus] 33 -140 0
wait 3
cmd summon antcolonies:distichodus 33.5 -62.15 0.5 {NoAI:1b,Rotation:[-90f,0f],CustomName:'"film:nibble"'}
camera 31.87 -63.27 -1.13 -45 10
wait 10
cmd tick freeze
burst nibble_threequarter 18 2
cmd tick unfreeze
cmd tp @e[type=antcolonies:distichodus] 33 -140 0
wait 3
cmd summon antcolonies:distichodus 33.5 -62.15 0.5 {NoAI:1b,Rotation:[-90f,0f],CustomName:'"film:bolt"'}
camera 33.50 -63.67 -1.80 0 0
wait 10
cmd tick freeze
burst bolt_side 9 1
cmd tick unfreeze
cmd tp @e[type=antcolonies:distichodus] 33 -140 0
