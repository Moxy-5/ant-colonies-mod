cmd tp @e[type=antcolonies:distichodus] 33 -140 0
wait 3
cmd summon antcolonies:distichodus 33.5 -62.15 0.5 {NoAI:1b,Rotation:[-90f,0f],CustomName:'"film:bolt"'}
camera 35.80 -63.67 0.50 90 0
wait 10
cmd tick freeze
burst bolt_front 9 1
cmd tick unfreeze
cmd tp @e[type=antcolonies:distichodus] 33 -140 0
wait 3
cmd summon antcolonies:distichodus 33.5 -62.15 0.5 {NoAI:1b,Rotation:[-90f,0f],CustomName:'"film:leap"'}
camera 33.50 -63.67 -1.80 0 0
wait 10
cmd tick freeze
burst leap_side 20 1
cmd tick unfreeze
cmd tp @e[type=antcolonies:distichodus] 33 -140 0
wait 3
cmd summon antcolonies:distichodus 33.5 -62.15 0.5 {NoAI:1b,Rotation:[-90f,0f],CustomName:'"film:leap"'}
camera 31.87 -63.27 -1.13 -45 10
