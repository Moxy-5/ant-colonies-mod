# The crocodile's life step 3 (2026-11-15): the flop onto its belly to bask, the startled plunge, the half-out rest.
#   ./gradlew runFilm -PfilmScene=crocodile_life      pictures in run-film/screenshots/crocodile_life/
cmd time set noon
cmd weather clear
cmd fill 26 -63 12 40 -61 22 minecraft:water
lens 40
wait 40
# one in the pool wanting the sun climbs out, stops and flops down to bask
camera 22.0 -60.0 11.0 0 10
cmd summon antcolonies:crocodile 29.5 -60.5 17.0 {SunIn:0,Rotation:[90f,0f]}
wait 40
shot flop_040
wait 4
shot flop_044
wait 4
shot flop_048
