# Fish remains in the game (2026-11-15): every kind at its four stages on the ground, then a crocodile tearing a catfish.
#   ./gradlew runFilm -PfilmScene=remains      pictures in run-film/screenshots/remains/
cmd time set noon
cmd weather clear
cmd kill @e[type=!player]
lens 50
wait 20
cmd summon antcolonies:remains 20.5 -60 10.5 {kind:"catfish",bites:12,Rotation:[90f,0f]}
cmd summon antcolonies:remains 24.5 -60 10.5 {kind:"catfish",bites:8,Rotation:[90f,0f]}
cmd summon antcolonies:remains 28.5 -60 10.5 {kind:"catfish",bites:4,Rotation:[90f,0f]}
cmd summon antcolonies:remains 32.5 -60 10.5 {kind:"catfish",bites:0,Rotation:[90f,0f]}
cmd summon antcolonies:remains 20.5 -60 13.5 {kind:"catfish_torn",bites:9,Rotation:[90f,0f]}
cmd summon antcolonies:remains 24.5 -60 13.5 {kind:"catfish_torn",bites:6,Rotation:[90f,0f]}
cmd summon antcolonies:remains 28.5 -60 13.5 {kind:"catfish_torn",bites:3,Rotation:[90f,0f]}
cmd summon antcolonies:remains 32.5 -60 13.5 {kind:"catfish_torn",bites:0,Rotation:[90f,0f]}
cmd summon antcolonies:remains 20.5 -60 16.5 {kind:"tilapia",bites:6,Rotation:[90f,0f]}
cmd summon antcolonies:remains 24.5 -60 16.5 {kind:"tilapia",bites:4,Rotation:[90f,0f]}
cmd summon antcolonies:remains 28.5 -60 16.5 {kind:"tilapia",bites:2,Rotation:[90f,0f]}
cmd summon antcolonies:remains 32.5 -60 16.5 {kind:"tilapia",bites:0,Rotation:[90f,0f]}
wait 20
camera 26.0 -55.0 4.0 0 38
wait 4
shot lineup
