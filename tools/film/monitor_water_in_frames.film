# The Nile monitor walking into the water off a level bank, frame by frame (the Animal Maker Engine step 4, 2026-11-19;
# docs/plans/engine-step4-water.md): the game frozen and stepped 2 ticks between pictures through the move, close up,
# side on, from the water in front, and from behind on the bank. The bank's edge at x 1 (top y -60), water east of it,
# three blocks deep, its surface a ninth of a block under the bank's top.
#   ./gradlew runFilm -PfilmScene=tools/film/monitor_water_in_frames.film   pictures in run-film/screenshots/monitor_water_in_frames/
cmd time set noon
cmd weather clear
cmd kill @e[type=!player]
cmd fill -12 -63 -7 12 -62 7 minecraft:dirt
cmd fill -12 -61 -7 12 -61 7 minecraft:grass_block
cmd fill -12 -60 -7 12 -56 7 minecraft:air
cmd fill 1 -63 -7 12 -61 7 minecraft:water
lens 40
wait 40
# side on, close (the camera's height is its feet: its eye is 1.62 higher)
walker antcolonies:monitor -1.6 -60 0.5 -90 OwnSize:1.0f,HungryIn:99999,SunIn:99999
camera 1.2 -60.6 -4.8 0 4
cmd tick unfreeze
go 8 -61 0 0.8
wait 10
cmd tick freeze
burst side 80 2
cmd kill @e[type=antcolonies:monitor]
wait 10
# from the water in front
walker antcolonies:monitor -1.6 -60 0.5 -90 OwnSize:1.0f,HungryIn:99999,SunIn:99999
camera 5.2 -60.9 3.0 122 6
cmd tick unfreeze
go 8 -61 0 0.8
wait 10
cmd tick freeze
burst front 80 2
cmd kill @e[type=antcolonies:monitor]
wait 10
# from behind, three quarters, on the bank
walker antcolonies:monitor -1.6 -60 0.5 -90 OwnSize:1.0f,HungryIn:99999,SunIn:99999
camera -3.6 -59.4 -2.6 -55 18
cmd tick unfreeze
go 8 -61 0 0.8
wait 10
cmd tick freeze
burst back 80 2
cmd kill @e[type=antcolonies:monitor]
quit
