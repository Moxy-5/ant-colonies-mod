# A crab walking up a one-block step (2026-11-17, the user's report: crabs going up a block should stay sideways):
# on land, a hungry crab walks to remains on top of a step; then from a 1-deep pool up onto the bank.
#   ./gradlew runFilm -PfilmScene=tools/film/crab_step.film      pictures in run-film/screenshots/crab_step/
cmd time set noon
cmd weather clear
cmd kill @e[type=!player]
lens 40
wait 30
cmd fill 3 -60 0 9 -60 7 minecraft:grass_block
cmd summon antcolonies:remains 6.5 -59 3.5 {kind:"tilapia",bites:6,Rotation:[0f,0f]}
cmd summon antcolonies:crab 0.5 -60.0 3.5 {HungryIn:0,Rotation:[-90f,0f]}
camera 2.6 -59.9 -0.8 0 14
wait 4
shot land_00
wait 2
shot land_01
wait 2
shot land_02
wait 2
shot land_03
wait 2
shot land_04
wait 2
shot land_05
wait 2
shot land_06
wait 2
shot land_07
