shot land_28
wait 2
shot land_29
wait 2
cmd kill @e[type=antcolonies:crab]
cmd kill @e[type=antcolonies:remains]
wait 5
cmd fill 12 -61 0 18 -61 7 minecraft:water
cmd summon antcolonies:remains 21.5 -60 3.5 {kind:"tilapia",bites:6,Rotation:[0f,0f]}
cmd summon antcolonies:crab 16.5 -61.0 3.5 {HungryIn:0,Rotation:[-90f,0f]}
camera 18.6 -59.9 -0.8 0 14
