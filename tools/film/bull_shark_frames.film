# sizes and looks: a 5.0 (look A) and a 7.0 scarred old bull, from the side over the tank
cmd fill 1 -60 -3 13 -56 3 minecraft:water
cmd summon antcolonies:bull_shark 7.0 -59.6 -1.6 {NoAI:1b,Length:5.0f,Rotation:[-90f,0f],CustomName:'"film:idle"'}
cmd summon antcolonies:bull_shark 7.0 -58.2 1.6 {NoAI:1b,Length:7.0f,Rotation:[-90f,0f],CustomName:'"film:idle"'}
camera 7.00 -59.40 -14.50 0 2
wait 20
shot sizes_side
camera 7.00 -44.00 0.50 0 90
wait 10
shot sizes_above
cmd kill @e[type=antcolonies:bull_shark]
wait 5
# the game beside the approved v13 (tools/game_compare.py): the rest pose on the grass, out of the water, four cameras
cmd summon antcolonies:bull_shark 30.0 -60.00 0.5 {NoAI:1b,Length:5.5f,Rotation:[-90f,0f],CustomName:'"film:rest"'}
