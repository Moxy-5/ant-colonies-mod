# The African bullfrog in the game, frame by frame (prey plan step 3, 2026-11-20; CLAUDE.md's hard rule): every clip
# on a still frog named film:<clip> (it plays only that clip) from the side, three quarters (front) and the front, the
# game frozen and stepped a tick or more a picture; the tongue as the real action (film-act:tongue: clip and rope);
# then free frogs at the pool with a fly cloud. (A camera's height is its feet: the eye is 1.62 above.)
#   ./gradlew runFilm -PfilmScene=tools/film/bullfrog_frames.film   pictures in run-film/screenshots/bullfrog_frames/
cmd time set noon
cmd weather clear
cmd kill @e[type=!player]
# the pool: x 30..44, z -8..8, 3 deep, flush with the grass (its top -60); the land frog stands at 36.5 -60 14.5
cmd fill 30 -63 -8 44 -61 8 minecraft:water
cmd fill 33 -60 11 40 -57 18 minecraft:air
lens 40
wait 40
cmd summon antcolonies:bullfrog 36.5 -60.0 14.5 {NoAI:1b,PersistenceRequired:1b,Rotation:[-90f,0f],CustomName:'"film:idle"'}
camera 36.50 -61.42 12.90 0 3
wait 10
cmd tick freeze
burst idle_side 12 10
cmd tick unfreeze
cmd tp @e[type=antcolonies:bullfrog] 36 -140 14
wait 3
cmd summon antcolonies:bullfrog 36.5 -60.0 14.5 {NoAI:1b,PersistenceRequired:1b,Rotation:[-90f,0f],CustomName:'"film:idle"'}
camera 37.65 -61.12 13.35 45 12
