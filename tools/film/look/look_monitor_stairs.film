# a close look at the monitor (step 2), every 3 ticks
lens 50
cmd fill 0 -60 -7 12 -60 7 minecraft:grass_block
cmd fill 3 -59 -7 12 -59 7 minecraft:grass_block
cmd fill 6 -58 -7 12 -58 7 minecraft:grass_block
cmd fill 9 -57 -7 12 -57 7 minecraft:grass_block
