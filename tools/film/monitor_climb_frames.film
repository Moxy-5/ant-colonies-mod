# The Nile monitor's climb up a block, frame by frame (2026-11-19; docs/plans/engine-step2-climb.md): the game frozen
# and stepped 2 ticks between pictures through the climb, close up, side on, from the front on top of the step, and from behind. The step's west face at x 10.
#   ./gradlew runFilm -PfilmScene=tools/film/monitor_climb_frames.film   pictures in run-film/screenshots/monitor_climb_frames/
cmd time set noon
cmd weather clear
cmd kill @e[type=!player]
cmd fill 10 -60 -6 16 -60 6 minecraft:stone
lens 40
wait 40
# side on, close (the camera's height is its feet: its eye is 1.62 higher)
walker antcolonies:monitor 6.5 -60 0.5 -90 OwnSize:1.0f,HungryIn:99999,SunIn:99999
camera 9.5 -60.4 -4.6 0 2
cmd tick unfreeze
go 13 -59 0 0.8
wait 24
cmd tick freeze
burst side 56 2
cmd kill @e[type=antcolonies:monitor]
wait 10
# from the front, on top of the step
walker antcolonies:monitor 6.5 -60 0.5 -90 OwnSize:1.0f,HungryIn:99999,SunIn:99999
camera 13.5 -59.5 -2.5 53 14
cmd tick unfreeze
go 13 -59 0 0.8
wait 24
cmd tick freeze
burst front 56 2
cmd kill @e[type=antcolonies:monitor]
wait 10
# from behind, three quarters
walker antcolonies:monitor 6.5 -60 0.5 -90 OwnSize:1.0f,HungryIn:99999,SunIn:99999
camera 5.0 -59.9 -2.8 -56 12
cmd tick unfreeze
go 13 -59 0 0.8
wait 24
cmd tick freeze
burst back 56 2
cmd kill @e[type=antcolonies:monitor]
quit
