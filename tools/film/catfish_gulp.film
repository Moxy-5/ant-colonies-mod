# The catfish comes up for a gulp of air (2026-11-18, the user's ask): a catfish on the bottom of a tank of water (walls
# no one sees) wanting air at once; it rises nose first, holds with its snout out, opens wide, snaps a gulp with a
# splash, and dives letting bubbles out of its gills. Seen from the side, the eye just over the surface.
#   ./gradlew runFilm -PfilmScene=tools/film/catfish_gulp.film      pictures in run-film/screenshots/catfish_gulp/
cmd time set noon
cmd weather clear
cmd kill @e[type=!player]
cmd fill -5 -61 -5 5 -53 4 minecraft:barrier hollow
cmd fill -4 -60 -4 4 -54 3 minecraft:water
lens 50
wait 40
# (the camera's height is its feet: its eye is 1.62 higher)
camera 1.0 -53.6 -5.5 10 20
cmd summon antcolonies:catfish 0.0 -59.6 0.0 {OwnSize:1.0f,HungryIn:99999,GulpIn:1,Rotation:[-90f,0f]}
wait 3
shot up_00
wait 3
shot up_01
wait 3
shot up_02
wait 3
shot up_03
wait 3
shot up_04
wait 3
