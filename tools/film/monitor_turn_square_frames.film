# The Nile monitor coming at a step 60 degrees off square (the Animal Maker Engine step B, 2026-11-20): it turns square
# on the spot (its walk stepping round), then climbs with its move. Frozen and stepped 2 ticks a picture, side on, from
# the front on top of the step, and from behind. The step's west face at x 10; the monitor set down where the climb
# starts (2.3 blocks short of it), facing 60 degrees off.
#   ./gradlew runFilm -PfilmScene=tools/film/monitor_turn_square_frames.film   pictures in run-film/screenshots/monitor_turn_square_frames/
cmd time set noon
cmd weather clear
cmd kill @e[type=!player]
cmd fill 10 -60 -6 16 -60 6 minecraft:stone
lens 40
wait 40
walker antcolonies:monitor 7.7 -60 0.5 -30 OwnSize:1.0f,HungryIn:99999,SunIn:99999
camera 8.5 -60.4 -4.6 0 2
cmd tick unfreeze
go 14 -59 0 0.8
wait 2
cmd tick freeze
burst side 45 2
cmd kill @e[type=antcolonies:monitor]
wait 10
walker antcolonies:monitor 7.7 -60 0.5 -30 OwnSize:1.0f,HungryIn:99999,SunIn:99999
camera 13.5 -59.5 -2.5 53 14
cmd tick unfreeze
go 14 -59 0 0.8
wait 2
cmd tick freeze
burst front 45 2
cmd kill @e[type=antcolonies:monitor]
wait 10
walker antcolonies:monitor 7.7 -60 0.5 -30 OwnSize:1.0f,HungryIn:99999,SunIn:99999
camera 4.0 -59.9 -2.8 -56 12
cmd tick unfreeze
go 14 -59 0 0.8
wait 2
cmd tick freeze
burst back 45 2
cmd kill @e[type=antcolonies:monitor]
quit
