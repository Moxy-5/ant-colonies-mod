# The crocodile hauls a cow off the bank (2026-11-15, the user's ask): out of the water at it, the tug of war, into the water.
#   ./gradlew runFilm -PfilmScene=crocodile_drag      pictures in run-film/screenshots/crocodile_drag/
cmd time set noon
cmd weather clear
cmd fill 26 -63 8 44 -61 26 minecraft:water
lens 50
wait 40
cmd summon antcolonies:crocodile 32.5 -61 17.0 {HungerIn:0,SunIn:100000,StrikeLuck:1b,Rotation:[90f,0f]}
cmd summon minecraft:cow 22.6 -60 17.0 {NoAI:1b,Rotation:[90f,0f]}
camera 25.5 -56.0 8.0 0 30
wait 4
