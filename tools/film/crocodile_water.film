shot in_106
wait 6
shot in_112
wait 6
shot in_118
wait 6
shot in_124
wait 6
shot in_130
wait 6
shot in_136
wait 6
shot in_142
wait 6
shot in_148
wait 6
shot in_154
wait 6
shot in_160
cmd tp @e[type=antcolonies:crocodile] 0 -120 0
wait 10
# a live one in the water wanting the sun climbs out onto the bank
camera 26.0 -60.4 -9.0 0 10
cmd summon antcolonies:crocodile 28.0 -61.5 0.0 {SunIn:0,Rotation:[90f,0f]}
wait 10
shot out_010
wait 10
shot out_020
wait 10
shot out_030
