# The crocodile going into and out of the water (its life steps 1 and 2, 2026-11-15): a level bank, the water flush with
# the grass as on the mod's savanna rivers, and a pool with a bank a block above the water. The body lies on what is under
# it and each leg pair folds over deep water and stands where its feet find ground.
#   ./gradlew runFilm -PfilmScene=crocodile_water      pictures in run-film/screenshots/crocodile_water/
cmd time set noon
cmd weather clear
cmd fill 26 -61 -4 40 -61 4 minecraft:air
cmd fill 26 -63 -4 40 -62 4 minecraft:water
cmd fill 26 -63 12 40 -61 22 minecraft:water
lens 40
wait 40
# (the camera's height is its feet: its eye is 1.62 higher)
# still ones on the level bank: one with its head out over the water, one in the water with its front on the bank
camera 25.0 -60.0 11.0 0 12
cmd summon antcolonies:crocodile 24.6 -60.0 17.0 {NoAI:1b,Rotation:[-90f,0f]}
wait 30
shot level_edge_side
cmd tp @e[type=antcolonies:crocodile] 0 -120 0
wait 10
cmd summon antcolonies:crocodile 27.4 -60.5 17.0 {NoAI:1b,NoGravity:1b,Rotation:[90f,0f]}
wait 30
shot level_halfout_side
camera 30.0 -58.0 13.5 40 30
wait 5
shot level_halfout_above
cmd tp @e[type=antcolonies:crocodile] 0 -120 0
wait 10
# the same by the step bank
camera 25.5 -60.4 -6.0 0 8
cmd summon antcolonies:crocodile 25.3 -60.0 0.0 {NoAI:1b,Rotation:[-90f,0f]}
wait 30
shot edge_side
cmd tp @e[type=antcolonies:crocodile] 0 -120 0
wait 10
cmd summon antcolonies:crocodile 26.6 -61.53 0.0 {NoAI:1b,NoGravity:1b,Rotation:[90f,0f]}
wait 30
shot halfout_side
camera 29.0 -58.0 -3.5 40 30
wait 5
shot halfout_above
cmd tp @e[type=antcolonies:crocodile] 0 -120 0
wait 10
# a live one walks off the grass into the level pool
camera 24.0 -60.0 10.0 0 10
cmd summon antcolonies:crocodile 20.0 -60.0 17.0 {SunIn:50000,Rotation:[-90f,0f]}
wait 30
shot in_030
wait 6
